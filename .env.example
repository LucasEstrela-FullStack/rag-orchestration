# Copie para .env e ajuste se precisar.

# Inngest: 1 = usa o dev server local (http://127.0.0.1:8288)
INNGEST_DEV=1

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docs

# Ollama
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=bge-m3
# Precisa bater com o modelo de embedding (bge-m3 = 1024).
EMBED_DIM=1024
LLM_MODEL=qwen2.5:3b
# Camadas na GPU. Vazio = automático; 0 = só CPU (use se a GPU travar o Ollama).
OLLAMA_NUM_GPU=
